# העתיקו ל-secret-full-stack.yaml והחילו לפני kubectl apply -k .
# הסיסמה חייבת להיות זהה ב-SA_PASSWORD ובמחרוזת החיבור (כמו ב-docker-compose).
apiVersion: v1
kind: Secret
metadata:
  name: education-db
  namespace: education-system
  labels:
    app.kubernetes.io/name: education-system
type: Opaque
stringData:
  SA_PASSWORD: "Education@123!"
  connection-string: >-
    Server=sqlserver,1433;Database=EducationSystem;User Id=sa;Password=Education@123!;TrustServerCertificate=True;
