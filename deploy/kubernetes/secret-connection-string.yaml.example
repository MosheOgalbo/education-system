# העתיקו ל-secret-connection-string.yaml (אל תעלו ל-git עם סיסמאות אמיתיות).
# עדכנו את מחרוזת החיבור ל-RDS / SQL מנוהל.
apiVersion: v1
kind: Secret
metadata:
  name: education-db
  namespace: education-system
  labels:
    app.kubernetes.io/name: education-system
type: Opaque
stringData:
  connection-string: >-
    Server=rds-or-sql-endpoint,1433;Database=EducationSystem;User Id=APP_USER;Password=CHANGE_ME;TrustServerCertificate=True;
